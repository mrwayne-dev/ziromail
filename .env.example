APP_NAME="Ziroemail"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PROTOTYPE=true

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ziroemail
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Sessions, cache and queue are database-backed so the session and device list is real and
# rate-limit counters are atomic on a host without Redis. Use `sync` and `array` only in tests.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Production: SESSION_COOKIE=__Host-ziroemail_session, SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# Hashing: argon2id where the server supports it (php -r 'var_dump(defined("PASSWORD_ARGON2ID"));'), else bcrypt.
HASH_DRIVER=argon2id
# Verify hashes of any algorithm (password_verify checks the stored hash's own), so a driver change never locks people out;
# rehash_on_login then upgrades them as they sign in.
HASH_VERIFY=false
BCRYPT_ROUNDS=12

# Sanctum stateful domains: the host(s) the browser app is served from.
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SANCTUM_TOKEN_PREFIX=zrm_

# Identity (docs/DASHBOARD_BUILD.md section 7)
AUTH_REGISTRATION_ENABLED=true
# Comma-separated addresses or @domains allowed to register. Empty allows everyone. Set it on the preview.
AUTH_REGISTRATION_ALLOWLIST=
AUTH_ENFORCE_TWO_FACTOR_FOR_OWNERS=false
AUTH_CHECK_PWNED=true

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@ziroemail.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
